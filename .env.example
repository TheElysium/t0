# Copy to .env for local use (not committed, see .gitignore).
# No real values here -- no credentials, no secrets, no production DSN.

# PostgreSQL connection DSN (contains database password: treated as SecretStr)
GARMINATOR_POSTGRES_DSN=

# Garmin session persistence directory.
# Name WITHOUT the GARMINATOR_ prefix: this is the variable read as-is by
# garminconnect 0.3.2 (`os.getenv("GARMINTOKENS")`), which has NO default path.
# Without this directory on a persistent volume, each restart performs a full
# SSO authentication -- which risks account lockout.
GARMINTOKENS=

# Directory (PVC) for archiving raw .FIT files
GARMINATOR_FIT_ARCHIVE_PATH=

# Garmin Connect account credentials.
# On cluster: created directly as Kubernetes Secret, never here.
GARMINATOR_GARMIN_USERNAME=
GARMINATOR_GARMIN_PASSWORD=

# --- Scheduler history window (optional: defaults from code) ---

# First day backfilled. Default 2025-04-03 (settings.py). Must stay aligned with
# the --history-start passed to `garminator-ops backfill-status`, otherwise the
# completion report compares different scopes and reports gaps that do not exist.
# GARMINATOR_HISTORY_START=2025-04-03

# Number of already-collected days each run replays anyway, to catch data that
# Garmin consolidates after the fact (sleep, HRV). Default 3, minimum 0.
# GARMINATOR_REFRESH_LOOKBACK_DAYS=3
