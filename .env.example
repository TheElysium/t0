# Copier en .env pour un usage local (non committé, voir .gitignore).
# Aucune valeur réelle ici — ni identifiant, ni secret, ni DSN de production.

# DSN de connexion PostgreSQL (contient le mot de passe de la base : traité en SecretStr)
GARMINATOR_POSTGRES_DSN=

# Répertoire de persistance de la session Garmin.
# Nom SANS le préfixe GARMINATOR_ : c'est la variable lue telle quelle par
# garminconnect 0.3.2 (`os.getenv("GARMINTOKENS")`), qui n'a AUCUN chemin par
# défaut. Sans ce répertoire sur un volume persistant, chaque redémarrage refait
# une authentification SSO complète — ce qui expose au blocage du compte.
GARMINTOKENS=

# Répertoire (PVC) d'archivage des fichiers .FIT bruts
GARMINATOR_FIT_ARCHIVE_PATH=

# Identifiants du compte Garmin Connect.
# Sur le cluster : créés directement comme Secret Kubernetes, jamais ici.
GARMINATOR_GARMIN_USERNAME=
GARMINATOR_GARMIN_PASSWORD=

# --- Fenêtre d'historique du scheduler (optionnel : valeurs par défaut du code) ---

# Premier jour rétro-collecté. Par défaut 2025-04-03 (settings.py). Doit rester aligné
# avec le --history-start passé à `garminator-ops backfill-status`, sinon le rapport de
# complétude compare deux périmètres différents et signale des trous qui n'en sont pas.
# GARMINATOR_HISTORY_START=2025-04-03

# Nombre de jours déjà collectés que chaque run rejoue malgré tout, pour rattraper les
# données que Garmin consolide après coup (sommeil, HRV). Par défaut 3, minimum 0.
# GARMINATOR_REFRESH_LOOKBACK_DAYS=3
