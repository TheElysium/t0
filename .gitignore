__pycache__/
*.pyc
.venv/
.env
*.egg-info/
.pytest_cache/
secrets/
*.secret.yaml

# Personal Garmin data -- never committed
/Activities.csv
/metrics&wellness_1year/
/data/
*.fit
!tests/fixtures/fit/*.fit
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/

# Garmin exports .FIT uppercase and git patterns are case-sensitive
*.FIT
*.Fit
!tests/fixtures/fit/*.FIT

# TCX exports (manual import) are not covered by *.fit patterns
*.tcx
*.TCX
!tests/fixtures/tcx/*.tcx

# Athlete seeding: the TEMPLATE is versioned, never the filled file.
# It contains weight, heart rates and physiological thresholds -- same
# reasoning as for .FIT files and their GPS traces.
deploy/seed/*.sql
!deploy/seed/*.sql.example

# IDE
.idea/
