# Minimal build context: only pyproject.toml, README.md, src/ and migrations/ are
# copied by Dockerfile. Everything else is excluded -- especially personal data,
# whose inclusion in the context would expose the risk of leaking into an
# image published on GHCR.

# --- Personal Garmin data -- MUST NEVER enter the context ---
Activities.csv
metrics&wellness_1year/
data/
*.fit
*.FIT
*.Fit

# --- Secrets and local configuration ---
.env
.env.*
!.env.example
secrets/
*.secret.yaml

# --- Environments and caches ---
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
dist/
build/

# --- Sources not needed for wheel building ---
.git/
.github/
.gitignore
deploy/
docs/
tests/
Dockerfile
.dockerignore
