# Contexte de build minimal : seuls pyproject.toml, README.md et src/ sont copiés
# par le Dockerfile. Tout le reste est exclu — en particulier les données
# personnelles, dont l'inclusion dans le contexte exposerait au risque de fuite
# vers une image publiée sur GHCR.

# --- Données personnelles Garmin — ne doivent JAMAIS entrer dans le contexte ---
Activities.csv
metrics&wellness_1year/
data/
*.fit
*.FIT
*.Fit

# --- Secrets et configuration locale ---
.env
.env.*
!.env.example
secrets/
*.secret.yaml

# --- Environnements et caches ---
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
dist/
build/

# --- Sources non nécessaires à la construction du wheel ---
.git/
.github/
.gitignore
deploy/
docs/
tests/
Dockerfile
.dockerignore
