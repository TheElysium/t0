{{/*
Short chart name.
*/}}
{{- define "t0.name" -}}
{{- default .Chart.Name .Values.nameOverride | trunc 63 | trimSuffix "-" -}}
{{- end -}}

{{/*
Full name (release + chart), truncated to 63 characters (DNS limit).
*/}}
{{- define "t0.fullname" -}}
{{- if .Values.fullnameOverride -}}
{{- .Values.fullnameOverride | trunc 63 | trimSuffix "-" -}}
{{- else -}}
{{- $name := default .Chart.Name .Values.nameOverride -}}
{{- if contains $name .Release.Name -}}
{{- .Release.Name | trunc 63 | trimSuffix "-" -}}
{{- else -}}
{{- printf "%s-%s" .Release.Name $name | trunc 63 | trimSuffix "-" -}}
{{- end -}}
{{- end -}}
{{- end -}}

{{/*
Chart + version, for the helm.sh/chart label.
*/}}
{{- define "t0.chart" -}}
{{- printf "%s-%s" .Chart.Name .Chart.Version | replace "+" "_" | trunc 63 | trimSuffix "-" -}}
{{- end -}}

{{/*
Common labels.
*/}}
{{- define "t0.labels" -}}
helm.sh/chart: {{ include "t0.chart" . }}
{{ include "t0.selectorLabels" . }}
app.kubernetes.io/managed-by: {{ .Release.Service }}
{{- if .Values.commonLabels }}
{{ toYaml .Values.commonLabels }}
{{- end }}
{{- end -}}

{{/*
Selector labels (stable across upgrades -- never touch).
*/}}
{{- define "t0.selectorLabels" -}}
app.kubernetes.io/name: {{ include "t0.name" . }}
app.kubernetes.io/instance: {{ .Release.Name }}
{{- end -}}

{{/*
Name of PostgreSQL authentication Secret.
*/}}
{{- define "t0.postgresql.secretName" -}}
{{- if .Values.postgresql.auth.existingSecret -}}
{{- .Values.postgresql.auth.existingSecret -}}
{{- else -}}
{{- printf "%s-postgresql" (include "t0.fullname" .) -}}
{{- end -}}
{{- end -}}

{{/*
Name of PostgreSQL service (headless).
*/}}
{{- define "t0.postgresql.serviceName" -}}
{{- printf "%s-postgresql" (include "t0.fullname" .) -}}
{{- end -}}

{{/*
Name of FIT archive PVC (shared: FIT files, Garmin token store,
PostgreSQL dumps -- see values.yaml fitArchive.subPaths).
*/}}
{{- define "t0.fitArchive.pvcName" -}}
{{- printf "%s-fit-archive" (include "t0.fullname" .) -}}
{{- end -}}

{{/*
Name of Grafana admin Secret.
*/}}
{{- define "t0.grafana.secretName" -}}
{{- if .Values.grafana.admin.existingSecret -}}
{{- .Values.grafana.admin.existingSecret -}}
{{- else -}}
{{- printf "%s-grafana" (include "t0.fullname" .) -}}
{{- end -}}
{{- end -}}

{{/*
Name of Grafana dashboards ConfigMap (mechanism planned for L9).
*/}}
{{- define "t0.grafana.dashboardsConfigMapName" -}}
{{- if .Values.grafana.dashboards.configMapName -}}
{{- .Values.grafana.dashboards.configMapName -}}
{{- else -}}
{{- printf "%s-grafana-dashboards" (include "t0.fullname" .) -}}
{{- end -}}
{{- end -}}

{{/*
Ingest image tag: the provided one, otherwise chart AppVersion.
*/}}
{{- define "t0.ingest.imageTag" -}}
{{- default .Chart.AppVersion .Values.ingest.image.tag -}}
{{- end -}}

{{/*
PostgreSQL application password.

DELIBERATELY NO RANDOM GENERATION. The real PostgreSQL password is frozen by
`initdb` at data volume creation and is never read from POSTGRES_PASSWORD again.
Any value regenerated at `helm upgrade` would create a Secret out of sync with
the volume, and thus authentication rejection on a database that worked the day
before.

`lookup` cannot serve as a safeguard: it returns an empty value during
`helm template`, during `--dry-run`, and in any `helm template | kubectl apply`
flow. The password must therefore be provided explicitly, or come from a
pre-existing Secret (`postgresql.auth.existingSecret`).
*/}}
{{- define "t0.postgresql.password" -}}
{{- if .Values.postgresql.auth.password -}}
{{- .Values.postgresql.auth.password -}}
{{- else -}}
{{- fail "\n\nERROR: postgresql.auth.password is mandatory.\n\nNo PostgreSQL password is generated by this chart: the real password is frozen\nby initdb at volume creation, and a password regenerated on every `helm upgrade`\nwould silently break authentication in a hard-to-diagnose way.\n\nTwo solutions:\n\n  1. Provide the password in values (generate once, then keep in local values file,\n     outside git repository):\n\n       openssl rand -base64 32 | tr -d '/+=' | cut -c1-32\n       helm install ... --set postgresql.auth.password='<the password>'\n\n  2. Reference a pre-existing Kubernetes Secret with keys `username` and\n     `password`:\n\n       kubectl create secret generic t0-postgresql \\\n         --namespace t0 \\\n         --from-literal=username=t0 \\\n         --from-literal=password='<the password>'\n       helm install ... --set postgresql.auth.existingSecret=t0-postgresql\n" -}}
{{- end -}}
{{- end -}}

{{/*
Grafana admin password. Same rule as above: no random generation, so a
`helm upgrade` never drifts the Secret content from what the athlete knows.
*/}}
{{- define "t0.grafana.adminPassword" -}}
{{- if .Values.grafana.admin.password -}}
{{- .Values.grafana.admin.password -}}
{{- else -}}
{{- fail "\n\nERROR: grafana.admin.password is mandatory.\n\nNo password is generated by this chart (a password regenerated on every `helm upgrade`\nsilently drifts from what the athlete noted).\n\n  helm install ... --set grafana.admin.password='<the password>'\n\nor reference a pre-existing Secret with keys `admin-user` and `admin-password`\nvia grafana.admin.existingSecret.\n" -}}
{{- end -}}
{{- end -}}

{{/*
Exposure safeguard: the athlete's requirement is STRICTLY LOCAL access
(no Ingress, no TLS, no exposure outside cluster). We therefore refuse Service
types that would open external access.
*/}}
{{- define "t0.assertLocalOnlyService" -}}
{{- $type := .type -}}
{{- if not (eq $type "ClusterIP") -}}
{{- fail (printf "\n\nERROR: %s = %q.\n\nThis chart is designed for strictly local access (no Ingress, no TLS).\nOnly ClusterIP type is allowed; access is via `kubectl port-forward`.\nExposing these services as NodePort or LoadBalancer would publish Grafana and the\nFIT upload endpoint without TLS on the network.\n" .key $type) -}}
{{- end -}}
{{- end -}}

{{/*
Grafana.com plugin ids to install, with empty entries dropped. Why not
`.Values.grafana.plugins` directly: `helm --set grafana.plugins={}` (the documented
--set syntax for an empty list) actually yields the one-element slice [""], and a
blank GF_INSTALL_PLUGINS entry would make Grafana attempt to install a plugin named ""
at startup. Returns a JSON array string; use `| fromJsonArray`.
*/}}
{{- define "t0.grafana.plugins" -}}
{{- $plugins := list -}}
{{- range .Values.grafana.plugins -}}
{{- if . -}}
{{- $plugins = append $plugins . -}}
{{- end -}}
{{- end -}}
{{- $plugins | toJson -}}
{{- end -}}

{{/*
Pod scheduling constraints, shared by every workload of the release.
The fit-archive PVC is ReadWriteOnce and is mounted by five workloads: on a
multi-node cluster they must all land on the node holding the volume, otherwise
the ones scheduled elsewhere stay Pending forever. Pinning the whole release with
a nodeSelector is the simplest way to guarantee that; a ReadWriteMany
StorageClass removes the need for it.
*/}}
{{- define "t0.scheduling" -}}
{{- with .Values.scheduling.nodeSelector }}
nodeSelector:
  {{- toYaml . | nindent 2 }}
{{- end }}
{{- with .Values.scheduling.affinity }}
affinity:
  {{- toYaml . | nindent 2 }}
{{- end }}
{{- with .Values.scheduling.tolerations }}
tolerations:
  {{- toYaml . | nindent 2 }}
{{- end }}
{{- end -}}
