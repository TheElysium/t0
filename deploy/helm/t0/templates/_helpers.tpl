{{/*
Short chart name.
*/}}
{{- define "t0.name" -}}
{{- default .Chart.Name .Values.nameOverride | trunc 63 | trimSuffix "-" -}}
{{- end -}}

{{/*
Full name (release + chart), truncated to 63 characters (DNS limit).
*/}}
{{- define "t0.fullname" -}}
{{- if .Values.fullnameOverride -}}
{{- .Values.fullnameOverride | trunc 63 | trimSuffix "-" -}}
{{- else -}}
{{- $name := default .Chart.Name .Values.nameOverride -}}
{{- if contains $name .Release.Name -}}
{{- .Release.Name | trunc 63 | trimSuffix "-" -}}
{{- else -}}
{{- printf "%s-%s" .Release.Name $name | trunc 63 | trimSuffix "-" -}}
{{- end -}}
{{- end -}}
{{- end -}}

{{/*
Chart + version, for the helm.sh/chart label.
*/}}
{{- define "t0.chart" -}}
{{- printf "%s-%s" .Chart.Name .Chart.Version | replace "+" "_" | trunc 63 | trimSuffix "-" -}}
{{- end -}}

{{/*
Common labels.
*/}}
{{- define "t0.labels" -}}
helm.sh/chart: {{ include "t0.chart" . }}
{{ include "t0.selectorLabels" . }}
app.kubernetes.io/managed-by: {{ .Release.Service }}
{{- if .Values.commonLabels }}
{{ toYaml .Values.commonLabels }}
{{- end }}
{{- end -}}

{{/*
Selector labels (stable across upgrades -- never touch).
*/}}
{{- define "t0.selectorLabels" -}}
app.kubernetes.io/name: {{ include "t0.name" . }}
app.kubernetes.io/instance: {{ .Release.Name }}
{{- end -}}

{{/*
Name of the Secret holding the PostgreSQL credentials, whichever server is used.

Three cases, in order:
  - an explicit `auth.existingSecret` always wins;
  - with the embedded server, the chart creates the Secret itself;
  - with an external server, there is nothing to fall back on. The chart cannot
    invent a password for a database it does not own, so it refuses to render
    rather than emit a manifest that fails on the first connection.

The expected keys are `username` and `password`. That is also the shape of the
`<cluster>-app` Secret generated by the CloudNativePG operator, so it can be
referenced directly.
*/}}
{{- define "t0.postgresql.secretName" -}}
{{- if .Values.postgresql.auth.existingSecret -}}
{{- .Values.postgresql.auth.existingSecret -}}
{{- else if .Values.postgresql.enabled -}}
{{- printf "%s-postgresql" (include "t0.fullname" .) -}}
{{- else -}}
{{- fail "\n\nERROR: postgresql.enabled = false but postgresql.auth.existingSecret is empty.\n\nAn external PostgreSQL server owns its own credentials; this chart has no way to\ncreate them. Point `postgresql.auth.existingSecret` at a Secret carrying the keys\n`username` and `password` -- with CloudNativePG that is the `<cluster>-app` Secret.\n" -}}
{{- end -}}
{{- end -}}

{{/*
Name of the headless Service in front of the embedded PostgreSQL StatefulSet.

Only meaningful when `postgresql.enabled` is true. Everything that CONNECTS must
use `t0.postgresql.host` instead, which also covers the external server.
*/}}
{{- define "t0.postgresql.serviceName" -}}
{{- printf "%s-postgresql" (include "t0.fullname" .) -}}
{{- end -}}

{{/*
Host to connect to: the embedded Service, or the external server.

An external host is deliberately NOT defaulted. A wrong default would resolve to
nothing and surface as a connection timeout, which reads like an outage rather
than like a missing setting.
*/}}
{{- define "t0.postgresql.host" -}}
{{- if .Values.postgresql.enabled -}}
{{- include "t0.postgresql.serviceName" . -}}
{{- else if .Values.postgresql.external.host -}}
{{- .Values.postgresql.external.host -}}
{{- else -}}
{{- fail "\n\nERROR: postgresql.enabled = false but postgresql.external.host is empty.\n\nSet the address of the PostgreSQL server to use. Inside the cluster, the short\nform `<service>.<namespace>` is enough -- with CloudNativePG, the read-write\nService is named `<cluster>-rw`.\n" -}}
{{- end -}}
{{- end -}}

{{/*
Port to connect to. Two separate values on purpose: `service.port` belongs to the
Service this chart creates, `external.port` to a server it does not control.
*/}}
{{- define "t0.postgresql.port" -}}
{{- if .Values.postgresql.enabled -}}
{{- .Values.postgresql.service.port -}}
{{- else -}}
{{- .Values.postgresql.external.port -}}
{{- end -}}
{{- end -}}

{{/*
One egress rule granting access to PostgreSQL, for the NetworkPolicies.

The peer changes with the server: a pod selector is enough while PostgreSQL lives
in this release, but it silently matches NOTHING once the server sits in another
namespace -- a NetworkPolicy peer never crosses a namespace boundary on its own.
Hence the namespace selector on the external path; without a declared namespace,
the rule falls back to "any namespace", still on the single database port.
*/}}
{{- define "t0.postgresqlEgressRule" -}}
- to:
{{- if .Values.postgresql.enabled }}
    - podSelector:
        matchLabels:
          {{- include "t0.selectorLabels" . | nindent 10 }}
          app.kubernetes.io/component: postgresql
{{- else if .Values.postgresql.external.namespace }}
    - namespaceSelector:
        matchLabels:
          kubernetes.io/metadata.name: {{ .Values.postgresql.external.namespace }}
{{- else }}
    - namespaceSelector: {}
{{- end }}
  ports:
    - port: {{ include "t0.postgresql.port" . }}
      protocol: TCP
{{- end -}}

{{/*
Name of FIT archive PVC (shared: FIT files, Garmin token store,
PostgreSQL dumps -- see values.yaml fitArchive.subPaths).
*/}}
{{- define "t0.fitArchive.pvcName" -}}
{{- printf "%s-fit-archive" (include "t0.fullname" .) -}}
{{- end -}}

{{/*
Name of Grafana admin Secret.
*/}}
{{- define "t0.grafana.secretName" -}}
{{- if .Values.grafana.admin.existingSecret -}}
{{- .Values.grafana.admin.existingSecret -}}
{{- else -}}
{{- printf "%s-grafana" (include "t0.fullname" .) -}}
{{- end -}}
{{- end -}}

{{/*
Name of Grafana dashboards ConfigMap (mechanism planned for L9).
*/}}
{{- define "t0.grafana.dashboardsConfigMapName" -}}
{{- if .Values.grafana.dashboards.configMapName -}}
{{- .Values.grafana.dashboards.configMapName -}}
{{- else -}}
{{- printf "%s-grafana-dashboards" (include "t0.fullname" .) -}}
{{- end -}}
{{- end -}}

{{/*
Ingest image tag: the provided one, otherwise chart AppVersion.
*/}}
{{- define "t0.ingest.imageTag" -}}
{{- default .Chart.AppVersion .Values.ingest.image.tag -}}
{{- end -}}

{{/*
PostgreSQL application password.

DELIBERATELY NO RANDOM GENERATION. The real PostgreSQL password is frozen by
`initdb` at data volume creation and is never read from POSTGRES_PASSWORD again.
Any value regenerated at `helm upgrade` would create a Secret out of sync with
the volume, and thus authentication rejection on a database that worked the day
before.

`lookup` cannot serve as a safeguard: it returns an empty value during
`helm template`, during `--dry-run`, and in any `helm template | kubectl apply`
flow. The password must therefore be provided explicitly, or come from a
pre-existing Secret (`postgresql.auth.existingSecret`).
*/}}
{{- define "t0.postgresql.password" -}}
{{- if .Values.postgresql.auth.password -}}
{{- .Values.postgresql.auth.password -}}
{{- else -}}
{{- fail "\n\nERROR: postgresql.auth.password is mandatory.\n\nNo PostgreSQL password is generated by this chart: the real password is frozen\nby initdb at volume creation, and a password regenerated on every `helm upgrade`\nwould silently break authentication in a hard-to-diagnose way.\n\nTwo solutions:\n\n  1. Provide the password in values (generate once, then keep in local values file,\n     outside git repository):\n\n       openssl rand -base64 32 | tr -d '/+=' | cut -c1-32\n       helm install ... --set postgresql.auth.password='<the password>'\n\n  2. Reference a pre-existing Kubernetes Secret with keys `username` and\n     `password`:\n\n       kubectl create secret generic t0-postgresql \\\n         --namespace t0 \\\n         --from-literal=username=t0 \\\n         --from-literal=password='<the password>'\n       helm install ... --set postgresql.auth.existingSecret=t0-postgresql\n" -}}
{{- end -}}
{{- end -}}

{{/*
Grafana admin password. Same rule as above: no random generation, so a
`helm upgrade` never drifts the Secret content from what the athlete knows.
*/}}
{{- define "t0.grafana.adminPassword" -}}
{{- if .Values.grafana.admin.password -}}
{{- .Values.grafana.admin.password -}}
{{- else -}}
{{- fail "\n\nERROR: grafana.admin.password is mandatory.\n\nNo password is generated by this chart (a password regenerated on every `helm upgrade`\nsilently drifts from what the athlete noted).\n\n  helm install ... --set grafana.admin.password='<the password>'\n\nor reference a pre-existing Secret with keys `admin-user` and `admin-password`\nvia grafana.admin.existingSecret.\n" -}}
{{- end -}}
{{- end -}}

{{/*
Exposure safeguard: refuse a Service type this chart is not designed for.

Arguments (dict):
  - `key`     the values path, quoted back in the message so the reader knows what to fix
  - `type`    the configured value
  - `allowed` the list of accepted types
  - `reason`  why the others are refused, for THIS Service

Why the policy is passed in rather than hardcoded here: the two Services of this
chart carry very different risk. Grafana sits behind an admin password and is
meant to be reachable from the LAN; the ingest Service is an UNAUTHENTICATED
upload endpoint that must never leave the cluster network. A single chart-wide
"ClusterIP only" rule forced both to be relaxed at once, which is exactly the
mistake this safeguard exists to prevent.
*/}}
{{- define "t0.assertServiceType" -}}
{{- if not (has .type .allowed) -}}
{{- fail (printf "\n\nERROR: %s = %q.\n\nAccepted values: %s.\n\n%s\n" .key .type (join ", " .allowed) .reason) -}}
{{- end -}}
{{- end -}}

{{/*
Grafana.com plugin ids to install, with empty entries dropped. Why not
`.Values.grafana.plugins` directly: `helm --set grafana.plugins={}` (the documented
--set syntax for an empty list) actually yields the one-element slice [""], and a
blank GF_INSTALL_PLUGINS entry would make Grafana attempt to install a plugin named ""
at startup. Returns a JSON array string; use `| fromJsonArray`.
*/}}
{{- define "t0.grafana.plugins" -}}
{{- $plugins := list -}}
{{- range .Values.grafana.plugins -}}
{{- if . -}}
{{- $plugins = append $plugins . -}}
{{- end -}}
{{- end -}}
{{- $plugins | toJson -}}
{{- end -}}

{{/*
MCP image tag: the provided one, otherwise chart AppVersion. Same image as
ingest -- the MCP is another entry point of the same package (see values.yaml,
mcp.image).
*/}}
{{- define "t0.mcp.imageTag" -}}
{{- default .Chart.AppVersion .Values.mcp.image.tag -}}
{{- end -}}

{{/*
Name of the Secret holding the MCP Bearer token, whichever way it is provided.
*/}}
{{- define "t0.mcp.bearerSecretName" -}}
{{- if .Values.mcp.auth.bearerTokenExistingSecret -}}
{{- .Values.mcp.auth.bearerTokenExistingSecret -}}
{{- else -}}
{{- printf "%s-mcp-auth" (include "t0.fullname" .) -}}
{{- end -}}
{{- end -}}

{{/*
MCP Bearer token value, used ONLY by the chart-created Secret
(templates/mcp-secret.yaml). DELIBERATELY NO RANDOM GENERATION: the token is
set once in the client configuration (`claude mcp add ... --header
"Authorization: Bearer <token>"`); a token regenerated on every `helm upgrade`
would silently break it. `lookup` cannot serve as a safeguard either -- it
returns an empty value during `helm template` and `--dry-run`.
*/}}
{{- define "t0.mcp.bearerToken" -}}
{{- if .Values.mcp.auth.bearerToken -}}
{{- .Values.mcp.auth.bearerToken -}}
{{- else -}}
{{- fail "\n\nERROR: mcp.enabled = true but neither mcp.auth.bearerTokenExistingSecret nor mcp.auth.bearerToken is set.\n\nThe MCP server rejects every request without a valid Bearer token: without one\nit would either refuse to start or serve the training data unauthenticated.\nNo token is generated by this chart -- a token regenerated on every `helm upgrade`\nwould silently break the client configuration.\n\nTwo solutions:\n\n  1. Create the Secret once, then reference it (preferred):\n\n       openssl rand -base64 32 | tr -d '/+=' | cut -c1-32\n       kubectl create secret generic t0-mcp-auth \\\n         --namespace t0 \\\n         --from-literal=token='<the token>'\n       helm install ... --set mcp.auth.bearerTokenExistingSecret=t0-mcp-auth\n\n  2. For offline validation only, pass the token directly (the chart then\n     creates the Secret; never commit that values file):\n\n       helm template ... --set mcp.auth.bearerToken='<the token>'\n" -}}
{{- end -}}
{{- end -}}

{{/*
Name of the pre-existing Secret carrying the DSN of the read-only PostgreSQL
role `t0_mcp_ro`.

No fallback, no chart-created Secret: the role itself is created on the server
side (CloudNativePG `managed.roles`, or any role-creation path) because the
application user cannot create roles; the chart cannot invent credentials for
a role it does not own, so it refuses to render rather than emit a manifest
that fails on the first connection.
*/}}
{{- define "t0.mcp.dsnSecretName" -}}
{{- if .Values.mcp.postgres.dsnExistingSecret -}}
{{- .Values.mcp.postgres.dsnExistingSecret -}}
{{- else -}}
{{- fail "\n\nERROR: mcp.enabled = true but mcp.postgres.dsnExistingSecret is empty.\n\nThe MCP connects to PostgreSQL through the DEDICATED read-only role `t0_mcp_ro`\n-- never the application credentials. That role and its Secret are created on\nthe server side (CNPG managed.roles); this chart only references the Secret.\n\nCreate it in the release namespace, carrying the full DSN under the key\n`mcp.postgres.dsnKey` (default `dsn`):\n\n  kubectl create secret generic t0-mcp-ro-dsn \\\n    --namespace t0 \\\n    --from-literal=dsn='postgresql://t0_mcp_ro:<password>@<host>:5432/t0'\n  helm install ... --set mcp.postgres.dsnExistingSecret=t0-mcp-ro-dsn\n" -}}
{{- end -}}
{{- end -}}

{{/*
Pod scheduling constraints, shared by every workload of the release.
The fit-archive PVC is ReadWriteOnce and is mounted by five workloads: on a
multi-node cluster they must all land on the node holding the volume, otherwise
the ones scheduled elsewhere stay Pending forever. Pinning the whole release with
a nodeSelector is the simplest way to guarantee that; a ReadWriteMany
StorageClass removes the need for it.
*/}}
{{- define "t0.scheduling" -}}
{{- with .Values.scheduling.nodeSelector }}
nodeSelector:
  {{- toYaml . | nindent 2 }}
{{- end }}
{{- with .Values.scheduling.affinity }}
affinity:
  {{- toYaml . | nindent 2 }}
{{- end }}
{{- with .Values.scheduling.tolerations }}
tolerations:
  {{- toYaml . | nindent 2 }}
{{- end }}
{{- end -}}

{{/*
PostgreSQL connection environment, shared by the workloads that only need a
database (the migration hook so far). Emits an `env` LIST, to be spliced into an
existing `env:` key -- it does not emit the key itself.

The three entries are ordered, not alphabetised: Kubernetes resolves $(VAR) only
among variables ALREADY declared earlier in the same list, so PGUSER and
PGPASSWORD must come before T0_POSTGRES_DSN.

The DSN is passed as an environment variable and NEVER as an --dsn argument: a
command-line argument is visible in plain text in the container process list,
including via `kubectl describe pod`.

Every workload that talks to PostgreSQL now goes through this helper. They used to
inline the block; the switch was forced by the server address becoming a choice
rather than a constant, and having eight copies of that choice was untenable.
*/}}
{{- define "t0.postgresEnv" -}}
- name: PGUSER
  valueFrom:
    secretKeyRef:
      name: {{ include "t0.postgresql.secretName" . }}
      key: username
- name: PGPASSWORD
  valueFrom:
    secretKeyRef:
      name: {{ include "t0.postgresql.secretName" . }}
      key: password
- name: T0_POSTGRES_DSN
  value: >-
    postgresql://$(PGUSER):$(PGPASSWORD)@{{ include "t0.postgresql.host" . }}:{{ include "t0.postgresql.port" . }}/{{ .Values.postgresql.auth.database }}
{{- end -}}
