-- Template for seeding `core.athlete` and `core.threshold`.
--
-- WHY THIS IS NOT A MIGRATION. The values below are personal data: weight,
-- heart rates, physiological thresholds. A migration is committed, pushed to GitHub
-- and replayed identically everywhere; this template stays a template, you copy it
-- out of the repository before filling it in. Same reasoning as for original .FIT
-- files, which carry GPS traces: the repository contains the PROCEDURE, never the data.
--
--   cp deploy/seed/athlete.sql.example ~/t0-seed.sql   # OUT of repo
--   $EDITOR ~/t0-seed.sql
--   psql "$T0_POSTGRES_DSN" -f ~/t0-seed.sql
--
-- WHY THIS IS MANDATORY. `python -m t0.transform` refuses to guess
-- the athlete: on an empty `core.athlete` it exits with code 2 without writing anything.
-- And without a `core.threshold` row, no TSS is ever calculated -- activities would be
-- recorded, but all training load would remain NULL.
--
-- The file is wrapped in a transaction: if anything goes wrong partway through,
-- nothing is inserted and it can be rerun as-is after fixing.

BEGIN;

-- `sex` is not cosmetic: it selects the Banister TRIMP coefficient
-- (0.64/1.92 male, 0.86/1.67 female). `birth_date` can remain NULL, no calculation
-- reads it today.
INSERT INTO core.athlete (display_name, sex, home_timezone)
VALUES ('<first_name>', '<male|female>', 'Europe/Paris');

-- The four lines below assume the previous INSERT produced
-- `athlete_id = 1`, which is the case on a fresh database. After partial failure,
-- the IDENTITY sequence may have advanced: check with `SELECT athlete_id FROM core.athlete;`
-- and adjust.
--
-- `validity` is a half-open interval [start, end). The missing upper bound designates
-- the CURRENT threshold; `<start>` is typically the history start date
-- (`ingest.config.backfillStartDate` from the Helm chart).
--
-- ABSOLUTE RULE GOING FORWARD: NEVER fix a threshold by UPDATE. Close the current
-- period and open a new one. An UPDATE would retroactively rewrite all CTL history
-- without any constraint objecting. The GiST exclusion constraint only guarantees no
-- overlap between two periods.

-- BIKE. `ftp_watts` = measured mechanical power. `rftp_watts` and `css_m_s` are
-- forbidden here by CHECK constraint: bike and run power scales are not comparable.
-- `power_source` documents measurement origin (`garmin_native`, `stryd`,
-- `powermeter_<model>`, `home_trainer`); changing it MUST close the period.
INSERT INTO core.threshold
  (athlete_id, discipline, validity, ftp_watts, power_source, source, note)
VALUES
  (1, 'bike', '[<start>,)', <ftp_watts>, '<power_source>', 'manual', NULL);

-- RUN. `ftp_pace_s_per_km` = threshold pace in SECONDS per kilometer (4:30/km = 270).
-- `rftp_watts` is run power modeled by Garmin: leave NULL until it has been
-- actually tested. NULL means "unknown" and makes the calculation fall back to pace;
-- a made-up value would produce false but plausible TSS.
INSERT INTO core.threshold
  (athlete_id, discipline, validity, ftp_pace_s_per_km, rftp_watts, power_source, source, note)
VALUES
  (1, 'run', '[<start>,)', <threshold_pace_s_per_km>, NULL, '<power_source>', 'manual', NULL);

-- SWIM. `css_m_s` = critical speed in METERS PER SECOND (1:50/100 m = 0.909091).
-- Set `css_estimated = true` if the value comes from the "1000 m TT x 0.97" fallback
-- rather than a real 200/400 m double test: Grafana distinguishes the two, sTSS based
-- on estimated CSS does not have the same status.
INSERT INTO core.threshold
  (athlete_id, discipline, validity, css_m_s, css_estimated, source, note)
VALUES
  (1, 'swim', '[<start>,)', <css_m_s>, <true|false>, 'manual', NULL);

-- COMMON TO ALL DISCIPLINES. This row, and only this one, is what hrTSS and TRIMP
-- calculation consults for heart rates: without it, no fallback load is calculable
-- for sessions without power.
INSERT INTO core.threshold
  (athlete_id, discipline, validity, lthr_bpm, hr_max_bpm, hr_rest_bpm, weight_kg, source)
VALUES
  (1, 'all', '[<start>,)', <lthr>, <hr_max>, <hr_rest>, <weight_kg>, 'manual');

COMMIT;
